font=IBM Plex Sans

max-icon-size=64

padding=8
margin=5
outer-margin=10

width=350
height=150
anchor=bottom-right

border-size=1
text-alignment=left
default-timeout=5000

sort=-time

[app-name=niri summary="Screenshot captured"]
# Open screenshot w/ latest name in directory, in imv
on-button-left=exec file="$(ls -t "$HOME"/Screenshots/*.png 2>/dev/null | head -n 1)"; [ -n "$file" ] && imv "$file" & makoctl dismiss

[app-name=toggle-recorder summary="Recording saved"]
on-button-left=exec f="$(ls -t "$HOME"/Screenshots/recording-*.mp4 2>/dev/null | head -1)"; [ -n "$f" ] && mpv "$f" & makoctl dismiss

[mode=dark]
border-color=#5F4E41
background-color=#3A3124
text-color=#ebe0bb

[mode=light]
background-color=#f1e3d1
text-color=#64513E
border-color=#B5A492

