[user]
	email = mujtaba.asim.amin@gmail.com
	name = masroof-maindak
	signingkey = ~/.ssh/id_ed25519.pub

[init]
	defaultBranch = main

[url "git@github.com:masroof-maindak/"]
	insteadOf = "gh:"

[url "git@github.com:bnm-ai/"]
	insteadOf = "bnm:"

[alias]
	a = add
	addm = !fzga
	ba = branch -a
	b = branch
	ca = commit --amend
	c = commit
	cl = clone
	cm = commit -m
	cob = checkout -b
	co = !fzchk
	dag = log --graph --oneline --all
	d = diff
	ds = diff --staged
	edit = !fzge
	f = fetch
	fuckit = reset --hard
	l3 = log -n 3
	last = log -1 HEAD
	l = pull
	nuke = branch -D
	pf = push --force
	po = push origin
	p = push
	r = restore
	rs = restore --staged
	sh = show HEAD
	ss = status -s
	s = status
	st = stash
	sw = switch
	undo = reset --soft HEAD^

[push]
	autoSetupRemote = true
[log]
	abbrevCommit = true
[status]
	branch = true
[core]
	editor = nvim
	pager = delta
[interactive]
    diffFilter = delta --color-only
[include]
	path = ~/.config/delta/themes.gitconfig
	path = ~/.config/delta/active.gitconfig
[delta]
    true-color = always
	navigate = true
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"
	tabs = 4
[merge]
	conflictStyle = zdiff3
[submodule]
	recurse = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
