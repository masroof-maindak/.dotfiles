#!/bin/sh

# Print the active swamp variant: `dark` or `light`.
#
# Uses darkman when it's around (host machine). Otherwise, asks the terminal
# for its background colour (OSC 11), which works through SSH and tmux (>= 3.4)
# since the local terminal/tmux answers. A DA1 query is sent right after; every
# terminal answers it, so we know when to stop reading even if OSC 11 is
# unsupported. Falls back to `dark`.

if command -v darkman >/dev/null 2>&1 && mode=$(darkman get 2>/dev/null); then
    echo "$mode"
    exit 0
fi

fallback() {
    echo dark
    exit 0
}

{ : </dev/tty; } 2>/dev/null || fallback

old=$(stty -g </dev/tty) || fallback
trap 'stty "$old" </dev/tty' EXIT INT TERM
stty raw -echo min 0 time 10 </dev/tty

printf '\033]11;?\033\\\033[c' >/dev/tty

resp=''
while c=$(dd bs=1 count=1 </dev/tty 2>/dev/null) && [ -n "$c" ]; do
    resp="$resp$c"
    case $resp in *'[?'*c) break ;; esac
done

# e.g. `ESC]11;rgb:2424/2020/1515 ESC\`; keep the top byte of each channel
rgb=$(printf '%s' "$resp" | sed -n 's|.*rgb:\([0-9a-fA-F]*\)/\([0-9a-fA-F]*\)/\([0-9a-fA-F]*\).*|\1 \2 \3|p')
[ -n "$rgb" ] || fallback

set -- $rgb
r=$(printf '%d' "0x$(printf '%.2s' "$1")")
g=$(printf '%d' "0x$(printf '%.2s' "$2")")
b=$(printf '%d' "0x$(printf '%.2s' "$3")")

if [ $((r * 299 + g * 587 + b * 114)) -lt 128000 ]; then
    echo dark
else
    echo light
fi
