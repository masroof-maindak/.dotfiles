#!/usr/bin/env bash
# Open journal entries for each relative day given (e.g. `jrnl -2 -1 0`); default: today
#   Relies on GNU date

[ $# -eq 0 ] && set -- 0

files=()
for rel in "$@"; do
    if [[ ! "$rel" =~ ^[+-]?[0-9]+$ ]]; then
        echo "Invalid date token '$rel'. Use n/+n/-n only." >&2
        exit 1
    fi
    d=$(date -d "$rel days" +'%Y-%m-%d')
    fpath="$VAULT_DIR/03 - Journal/$(date -d "$d" +'%Y')/$(date -d "$d" +'%m - %b')/$d.md"
    if [ -f "$fpath" ]; then
        files+=("$fpath")
    else
        echo "Note file for $d doesn't exist." >&2
    fi
done

[ ${#files[@]} -eq 0 ] && exit 1

cd "$VAULT_DIR" || exit 1 # To set it as the root in Neovim.
$EDITOR "${files[@]}"
