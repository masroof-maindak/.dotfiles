#!/usr/bin/env bash
# Fuzzily checkout a Git branch

if command -v delta >/dev/null 2>&1; then
    _preview_cmd='git show --color=always {-1} | delta'
else
    preview_cmd='git show --color=always {-1}'
fi

git branch --all |
    grep -vE '^[*+]|HEAD' |
    awk '{print $1}' |
    fzf -0 --preview="$preview_cmd" --preview-window='bottom:80%' |
    xargs -r git checkout
